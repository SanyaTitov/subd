CREATE TABLE faculty (
    faculty_name VARCHAR(50) PRIMARY KEY,
    faculty_dean VARCHAR(50) NOT NULL
);

INSERT INTO faculty(faculty_name, faculty_dean) VALUES
('ИВТ', 'Петров П.П.'),
('Экономика', 'Павлова О.И.');

CREATE TABLE Student (
    Student_ID INT PRIMARY KEY,
    full_name VARCHAR(50) NOT NULL,
    group_number VARCHAR(5) NOT NULL,
    faculty_name VARCHAR(50) NOT NULL,
    FOREIGN KEY (faculty_name) REFERENCES faculty(faculty_name)
);

